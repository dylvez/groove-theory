{
  "name": "groove-theory",
  "version": "1.0.0",
  "description": "A browser-based drum machine and music theory workstation",
  "author": "Groove Theory <groovetheoryapp@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dylvez/groove-theory.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:local": "tsc -b && vite build --base=/groove-theory/",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "npm run build && npx firebase deploy --only hosting",
    "deploy:local": "npm run build:local && rm -rf C:/family-server/apps/groove-theory/assets && cp -r dist/* C:/family-server/apps/groove-theory/"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "midi-writer-js": "^3.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tone": "^15.1.22",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
